---
import BlogCard from './BlogCard.astro';
import { initialsOf, socialLinks, type Author, type AuthorLang } from '../data/authors.ts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  author: Author;
  lang: AuthorLang;
  posts: CollectionEntry<'blog'>[];
}

const { author, lang, posts } = Astro.props;

const t = lang === 'pl'
  ? {
      home: 'Strona główna', homeHref: '/pl/',
      section: 'Wiedza', sectionHref: '/pl/wiedza/blog/',
      kicker: 'Autor',
      articles: 'Artykuły autora',
      count: (n: number) => (n === 1 ? '1 artykuł' : n < 5 ? `${n} artykuły` : `${n} artykułów`),
      empty: 'Brak opublikowanych artykułów.',
      back: 'Wszystkie artykuły',
    }
  : {
      home: 'Home', homeHref: '/',
      section: 'Resources', sectionHref: '/resources/blog/',
      kicker: 'Author',
      articles: 'Articles by this author',
      count: (n: number) => (n === 1 ? '1 article' : `${n} articles`),
      empty: 'No published articles yet.',
      back: 'All articles',
    };

const bio = author.bio?.[lang];
const role = author.role?.[lang];
const socials = socialLinks(author);
const initials = initialsOf(author.name);
---
<section class="author-hero">
  <div class="inoro-container">
    <nav class="author-hero__crumbs" aria-label="Breadcrumb">
      <a href={t.homeHref}>{t.home}</a>
      <span class="sep">/</span>
      <a href={t.sectionHref}>{t.section}</a>
      <span class="sep">/</span>
      <span>{author.name}</span>
    </nav>

    <div class="author-card">
      <div class="author-card__avatar">
        {author.photo
          ? <img src={author.photo} alt={author.name} width="112" height="112" loading="eager" decoding="async" />
          : <span class="author-card__initials" aria-hidden="true">{initials}</span>}
      </div>

      <div class="author-card__body">
        <span class="author-card__kicker">{t.kicker}</span>
        <h1>{author.name}</h1>
        {role && <p class="author-card__role">{role}</p>}
        {bio && <p class="author-card__bio">{bio}</p>}

        <div class="author-card__foot">
          <span class="author-card__count">{t.count(posts.length)}</span>
          {socials.map((s) => (
            <a class="author-card__social" href={s.url} target="_blank" rel="me noopener noreferrer">
              {s.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="author-posts">
  <div class="inoro-container">
    <h2 class="author-posts__title">{t.articles}</h2>
    {posts.length === 0 ? (
      <p class="author-posts__empty">{t.empty}</p>
    ) : (
      <div class="blog-grid">
        {posts.map((post) => (
          <BlogCard
            href={post.data.slug}
            title={post.data.title}
            excerpt={post.data.excerpt ?? post.data.description}
            category={post.data.category}
            date={post.data.date}
            author={post.data.author}
            cover={post.data.cover}
            coverAlt={post.data.coverAlt}
            coverGradient={post.data.coverGradient}
            readTime={post.data.readTime}
            lang={lang}
          />
        ))}
      </div>
    )}
    <p class="author-posts__back"><a href={t.sectionHref}>← {t.back}</a></p>
  </div>
</section>

<style>
  .author-hero {
    padding: 3.5rem 0 2.75rem;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    border-bottom: 1px solid #e2e8f0;
  }
  .author-hero__crumbs {
    font-size: 0.85rem;
    color: #64748b;
    margin-bottom: 1.5rem;
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .author-hero__crumbs a { color: #64748b; text-decoration: none; }
  .author-hero__crumbs a:hover { color: #1AA7E0; }
  .author-hero__crumbs .sep { color: #cbd5e1; }

  .author-card {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
  }
  .author-card__avatar {
    flex-shrink: 0;
    width: 112px;
    height: 112px;
    border-radius: 999px;
    overflow: hidden;
    background: #E8F5FC;
    border: 1px solid rgba(26, 167, 224, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .author-card__avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .author-card__initials {
    font-family: Sora, Inter, sans-serif;
    font-size: 2.1rem;
    font-weight: 700;
    color: #0E8AC1;
    letter-spacing: 0.02em;
  }
  .author-card__body { min-width: 0; }
  .author-card__kicker {
    display: inline-block;
    color: #1AA7E0;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }
  .author-card h1 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    line-height: 1.15;
    margin: 0 0 0.4rem;
    color: #0f172a;
  }
  .author-card__role {
    margin: 0 0 0.9rem;
    color: #475569;
    font-size: 1.05rem;
    font-weight: 500;
  }
  .author-card__bio {
    /* Kontener jest pełnej szerokości (wspólny z siatką wpisów) — długość
       linii ograniczamy tylko tekstowi, żeby dało się go czytać. */
    max-width: 62ch;
    margin: 0 0 1.1rem;
    color: #475569;
    line-height: 1.65;
    font-size: 0.98rem;
  }
  .author-card__foot {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .author-card__count {
    color: #64748b;
    font-size: 0.85rem;
  }
  .author-card__social {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #0E8AC1;
    text-decoration: none;
    background: #ffffff;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .author-card__social:hover { border-color: #1AA7E0; background: #E8F5FC; }

  .author-posts {
    padding: 3rem 0 5rem;
    background: #f8fafc;
    min-height: 40vh;
  }
  .author-posts__title {
    font-family: Sora, Inter, sans-serif;
    font-size: 1.35rem;
    color: #0f172a;
    margin: 0 0 1.5rem;
  }
  .author-posts__empty { color: #64748b; padding: 1rem 0 2rem; }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .author-posts__back { margin: 2rem 0 0; }
  .author-posts__back a {
    color: #0E8AC1;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .author-posts__back a:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .author-card { gap: 1.1rem; }
    .author-card__avatar { width: 76px; height: 76px; }
    .author-card__initials { font-size: 1.5rem; }
  }
</style>
