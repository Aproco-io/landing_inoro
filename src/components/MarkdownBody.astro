---
const { render } = Astro.props;
---
<section class="markdown-body">
  <div class="inoro-container">
    <article class="prose">
      <slot />
    </article>
  </div>
</section>

<style>
  .markdown-body { padding: 3.5rem 0; background: #ffffff; }
  .prose {
    max-width: 780px;
    margin: 0 auto;
    color: #334155;
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose :global(h2) {
    font-family: Sora, Inter, sans-serif;
    color: #0f172a;
    font-size: 1.75rem;
    margin: 2.5rem 0 1rem;
  }
  .prose :global(h3) {
    font-family: Sora, Inter, sans-serif;
    color: #0f172a;
    font-size: 1.35rem;
    margin: 2rem 0 0.75rem;
  }
  .prose :global(p) { margin: 0 0 1.25rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5rem; margin: 0 0 1.5rem; }
  .prose :global(li) { margin-bottom: 0.35rem; }
  .prose :global(a) { color: #1AA7E0; }
  .prose :global(img) {
    border-radius: 0.75rem;
    margin: 1.75rem 0;
    display: block;
    box-shadow: 0 12px 30px -18px rgba(15, 23, 42, 0.25);
  }
  .prose :global(blockquote) {
    border-left: 4px solid #1AA7E0;
    padding: 0.5rem 0 0.5rem 1.25rem;
    margin: 1.5rem 0;
    color: #475569;
    font-style: italic;
  }
  .prose :global(code) {
    background: #f1f5f9;
    padding: 0.15rem 0.35rem;
    border-radius: 0.3rem;
    font-size: 0.9em;
  }
  .prose :global(pre) {
    background: #0f172a;
    color: #e2e8f0;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  /* --- Tabele w treści markdown (blog, artykuły) ---------------------
     Markdown nie generuje wrappera, więc scroll musi wisieć na samej
     tabeli. `display: block` + `overflow-x: auto` sprawia, że na wąskim
     ekranie tabela przewija się w poziomie zamiast rozpychać stronę. */
  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.92rem;
    line-height: 1.55;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
  }
  .prose :global(thead) { background: #f8fafc; }
  .prose :global(th) {
    text-align: left;
    font-family: Sora, Inter, sans-serif;
    font-weight: 600;
    color: #0f172a;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid #e2e8f0;
    white-space: nowrap;
  }
  .prose :global(td) {
    padding: 0.8rem 1rem;
    color: #475569;
    border-bottom: 1px solid #f1f5f9;
    vertical-align: top;
    /* Bez justowania — na wąskiej kolumnie robi rzeki białych plam. */
    text-align: left;
    hyphens: auto;
  }
  .prose :global(tbody tr:last-child td) { border-bottom: none; }
  .prose :global(tbody tr:nth-child(even)) { background: #fcfdfe; }
  @media (max-width: 640px) {
    .prose :global(table) {
      font-size: 0.85rem;
    }
    .prose :global(th),
    .prose :global(td) { padding: 0.65rem 0.75rem; }
    .prose :global(th),
    .prose :global(td) { min-width: 9.5rem; }
    .prose :global(td:first-child),
    .prose :global(th:first-child) { min-width: 10.5rem; }
  }
</style>
