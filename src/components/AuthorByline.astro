---
import { resolveAuthor, initialsOf, authorHref } from '../data/authors.ts';

interface Props {
  /** Imię i nazwisko (lub slug) prosto z front mattera wpisu. */
  author: string;
  lang: 'pl' | 'en';
  /** Elementy metadanych obok autora: data, czas czytania itd. */
  meta?: string[];
}

const { author, lang, meta = [] } = Astro.props;
const a = resolveAuthor(author);
// Strona autora na naszej domenie — zwykły link w tym samym oknie.
// Konta redakcyjne linku nie dostają (authorHref zwraca undefined).
const href = authorHref(a, lang);
const role = a.role?.[lang];
const initials = initialsOf(a.name);
---
<div class="byline">
  <div class="byline__avatar" aria-hidden="true">
    {a.photo
      ? <img src={a.photo} alt="" width="40" height="40" loading="lazy" decoding="async" />
      : <span class="byline__initials">{initials}</span>}
  </div>

  <div class="byline__text">
    <span class="byline__name">
      {href ? <a href={href} rel="author">{a.name}</a> : a.name}
    </span>
    <span class="byline__meta">
      {role && <span class="byline__role">{role}</span>}
      {role && meta.length > 0 && <span class="byline__dot">·</span>}
      {meta.map((m, i) => (
        <>
          {i > 0 && <span class="byline__dot">·</span>}
          <span set:html={m} />
        </>
      ))}
    </span>
  </div>
</div>

<style>
  .byline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .byline__avatar {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    overflow: hidden;
    background: #E8F5FC;
    border: 1px solid rgba(26, 167, 224, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .byline__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .byline__initials {
    font-family: Sora, Inter, sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    color: #0E8AC1;
    letter-spacing: 0.02em;
  }
  .byline__text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .byline__name {
    font-weight: 600;
    font-size: 0.95rem;
    color: #0f172a;
    line-height: 1.3;
  }
  .byline__name a {
    /* Na dotyku nie ma hovera — bez delikatnego podkreślenia nazwisko
       wygląda jak zwykły tekst i nikt nie trafi na stronę autora. */
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(26, 167, 224, 0.45);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .byline__name a:hover,
  .byline__name a:focus-visible {
    color: #1AA7E0;
    text-decoration-color: currentColor;
  }
  .byline__meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    color: #64748b;
    font-size: 0.85rem;
    line-height: 1.4;
  }
  .byline__dot { opacity: 0.5; }
  @media (max-width: 560px) {
    /* Przy wąskim ekranie metadane łamią się na 2–3 linie i wyśrodkowany
       awatar zaczyna wisieć w powietrzu — kotwiczymy go do góry. */
    .byline { align-items: flex-start; }
    .byline__avatar { margin-top: 0.15rem; }
    .byline__meta { font-size: 0.8rem; }
  }
</style>
