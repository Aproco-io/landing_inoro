---
interface Props {
  href: string;
  title: string;
  excerpt?: string;
  category?: string;
  date: Date;
  author?: string;
  cover?: string;
  coverAlt?: string;
  coverGradient?: string;
  readTime?: number;
  lang: 'pl' | 'en';
}

const {
  href,
  title,
  excerpt,
  category,
  date,
  author,
  cover,
  coverAlt,
  coverGradient,
  readTime,
  lang,
} = Astro.props;

const locale = lang === 'pl' ? 'pl-PL' : 'en-US';
const formattedDate = new Intl.DateTimeFormat(locale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);

const minLabel = lang === 'pl' ? 'min czytania' : 'min read';

const gradients = [
  'linear-gradient(135deg, #1AA7E0 0%, #1e3a66 100%)',
  'linear-gradient(135deg, #0b1f3d 0%, #1AA7E0 100%)',
  'linear-gradient(135deg, #10b981 0%, #059669 100%)',
  'linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%)',
  'linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)',
];
const gradientChoice =
  coverGradient ??
  gradients[Math.abs(title.length + (category?.length ?? 0)) % gradients.length];
---
<a class="blog-card" href={href}>
  <div class="blog-card__cover">
    {cover ? (
      <img src={cover} alt={coverAlt ?? title} loading="lazy" />
    ) : (
      <div class="blog-card__gradient" style={`background: ${gradientChoice};`}>
        <span class="blog-card__mark">{(category ?? 'InOro').slice(0, 3).toUpperCase()}</span>
      </div>
    )}
    {category && <span class="blog-card__cat">{category}</span>}
  </div>
  <div class="blog-card__body">
    <h3 class="blog-card__title">{title}</h3>
    {excerpt && <p class="blog-card__excerpt">{excerpt}</p>}
    <div class="blog-card__meta">
      <span>{formattedDate}</span>
      {readTime && (
        <>
          <span class="blog-card__dot">·</span>
          <span>{readTime} {minLabel}</span>
        </>
      )}
    </div>
  </div>
</a>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0.9rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .blog-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 32px -20px rgba(15, 23, 42, 0.2);
    border-color: rgba(26, 167, 224, 0.4);
  }
  .blog-card__cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f1f5f9;
  }
  .blog-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .blog-card__gradient {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .blog-card__mark {
    font-family: Sora, Inter, sans-serif;
    color: rgba(255, 255, 255, 0.35);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .blog-card__cat {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    background: rgba(255, 255, 255, 0.92);
    color: #1e3a66;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.6rem;
    border-radius: 0.35rem;
    backdrop-filter: blur(3px);
  }
  .blog-card__body {
    padding: 1.25rem 1.35rem 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.65rem;
  }
  .blog-card__title {
    margin: 0;
    font-family: Sora, Inter, sans-serif;
    font-size: 1.15rem;
    line-height: 1.35;
    color: #0f172a;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card__excerpt {
    margin: 0;
    color: #64748b;
    font-size: 0.925rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card__meta {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #94a3b8;
    font-size: 0.8rem;
  }
  .blog-card__dot { opacity: 0.6; }
</style>
