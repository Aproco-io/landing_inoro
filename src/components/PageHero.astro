---
interface Props {
  kicker?: string;
  heading: string;
  subheading: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  breadcrumbs?: { label: string; href?: string }[];
}
const { kicker, heading, subheading, primaryCta, secondaryCta, breadcrumbs } = Astro.props;
---
<section class="page-hero">
  <div class="inoro-container">
    {breadcrumbs && breadcrumbs.length > 0 && (
      <nav class="page-hero__crumbs" aria-label="Breadcrumb">
        {breadcrumbs.map((crumb, i) => (
          <span>
            {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
            {i < breadcrumbs.length - 1 && <span class="sep">/</span>}
          </span>
        ))}
      </nav>
    )}
    {kicker && <span class="page-hero__kicker">{kicker}</span>}
    <h1>{heading}</h1>
    <p class="page-hero__sub">{subheading}</p>
    {(primaryCta || secondaryCta) && (
      <div class="page-hero__actions">
        {primaryCta && <a class="btn btn--primary" href={primaryCta.href}>{primaryCta.label}</a>}
        {secondaryCta && <a class="btn btn--ghost" href={secondaryCta.href}>{secondaryCta.label}</a>}
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    border-bottom: 1px solid #e2e8f0;
    overflow: hidden;
  }
  .page-hero::before {
    content: "";
    position: absolute;
    top: -140px;
    right: -140px;
    width: 380px;
    height: 380px;
    background: radial-gradient(closest-side, rgba(26, 167, 224, 0.16), transparent);
    filter: blur(20px);
    z-index: 0;
  }
  .page-hero > .inoro-container { position: relative; z-index: 1; max-width: 900px; }
  .page-hero__crumbs {
    font-size: 0.85rem;
    color: #64748b;
    margin-bottom: 1.25rem;
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .page-hero__crumbs a { color: #64748b; text-decoration: none; }
  .page-hero__crumbs a:hover { color: #1AA7E0; }
  .page-hero__crumbs .sep { color: #cbd5e1; margin: 0 0.25rem; }
  .page-hero__kicker {
    display: inline-block;
    color: #1AA7E0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .page-hero h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin: 0 0 1rem;
    color: #0f172a;
  }
  .page-hero__sub {
    font-size: 1.15rem;
    color: #475569;
    max-width: 640px;
    margin: 0 0 2rem;
    line-height: 1.65;
  }
  .page-hero__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 0.6rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.15s ease;
  }
  .btn--primary {
    background: #1AA7E0;
    color: #fff;
  }
  .btn--primary:hover {
    background: #0E8AC1;
  }
  .btn--ghost {
    background: transparent;
    color: #0f172a;
    border: 1px solid #cbd5e1;
  }
  .btn--ghost:hover {
    border-color: #1AA7E0;
    color: #1AA7E0;
  }
</style>
