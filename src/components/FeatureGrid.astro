---
interface Feature { icon?: string; title: string; description: string }
interface Props { heading?: string; kicker?: string; features: Feature[] }
const { heading, kicker, features } = Astro.props;
---
<section class="feature-grid">
  <div class="inoro-container">
    {(kicker || heading) && (
      <div class="feature-grid__head">
        {kicker && <span class="feature-grid__kicker">{kicker}</span>}
        {heading && <h2>{heading}</h2>}
      </div>
    )}
    <div class="feature-grid__items">
      {features.map((f) => (
        <div class="feature-card">
          <div class="feature-card__icon" aria-hidden="true">{f.icon ?? '★'}</div>
          <h3>{f.title}</h3>
          <p>{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-grid { padding: 4rem 0; background: #ffffff; }
  .feature-grid__head { text-align: center; max-width: 700px; margin: 0 auto 2.5rem; }
  .feature-grid__kicker {
    display: inline-block;
    color: #1AA7E0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .feature-grid__head h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0;
    color: #0f172a;
  }
  .feature-grid__items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .feature-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0.9rem;
    padding: 1.75rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .feature-card:hover {
    border-color: rgba(26, 167, 224, 0.35);
    box-shadow: 0 10px 25px -12px rgba(15, 23, 42, 0.12);
    transform: translateY(-2px);
  }
  .feature-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 0.6rem;
    background: rgba(26, 167, 224, 0.12);
    color: #1AA7E0;
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }
  .feature-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    color: #0f172a;
  }
  .feature-card p {
    margin: 0;
    color: #475569;
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>
