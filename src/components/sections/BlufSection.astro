---
interface Props { term?: string; body: string }
const { term, body } = Astro.props;
---
<section class="s-bluf">
  <div class="inoro-container">
    <div class="s-bluf__panel">
      <p>
        {term && <strong class="s-bluf__term">{term}</strong>}
        {term && ' — '}
        <span set:html={body} />
      </p>
    </div>
  </div>
</section>

<style>
  .s-bluf { padding: 2.5rem 0; background: #ffffff; }
  .s-bluf__panel {
    background: #E8F5FC;
    border: 1px solid rgba(26, 167, 224, 0.2);
    border-radius: 0.9rem;
    padding: 1.75rem 2rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .s-bluf__panel p {
    margin: 0;
    color: #0f172a;
    font-size: 1.05rem;
    line-height: 1.65;
  }
  .s-bluf__term {
    font-family: Play, Inter, sans-serif;
    font-weight: 700;
    color: #0E8AC1;
  }
</style>
