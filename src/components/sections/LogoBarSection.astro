---
interface Props { caption?: string; lang?: 'pl' | 'en' }
const { caption, lang = 'en' } = Astro.props;
const defaultCaption = lang === 'pl' ? 'Zaufali nam liderzy branży' : 'Trusted by industry leaders';
const logos = [
  { src: '/assets/logos/AASA_Logo.png', alt: 'AASA' },
  { src: '/assets/logos/tarczynski_logo.png', alt: 'Tarczyński' },
  { src: '/assets/logos/elocity_logo.png', alt: 'elocity' },
  { src: '/assets/logos/telbridge-logo.png', alt: 'Telbridge' },
  { src: '/assets/logos/onerent-logo.png', alt: 'Onerent' },
];
---
<section class="s-logobar">
  <div class="inoro-container">
    <p class="s-logobar__caption">{caption ?? defaultCaption}</p>
    <div class="s-logobar__grid">
      {logos.map((l) => (
        <div class="s-logobar__cell"><img src={l.src} alt={l.alt} loading="lazy" /></div>
      ))}
    </div>
  </div>
</section>

<style>
  .s-logobar { padding: 2.5rem 0; background: #fff; border-bottom: 1px solid #f1f5f9; }
  .s-logobar__caption {
    text-align: center;
    color: #64748b;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    margin: 0 0 1.5rem;
  }
  .s-logobar__grid {
    display: flex; gap: 2.5rem;
    align-items: center; justify-content: center;
    flex-wrap: wrap;
  }
  .s-logobar__cell {
    height: 40px; width: 130px;
    display: flex; align-items: center; justify-content: center;
  }
  .s-logobar__cell img {
    max-width: 100%; max-height: 100%;
    object-fit: contain;
    opacity: 0.75;
    transition: opacity 0.15s ease;
    filter: grayscale(20%);
  }
  .s-logobar__cell img:hover { opacity: 1; filter: none; }
</style>
