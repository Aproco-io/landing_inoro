---
interface Props {
  plans: {
    name: string;
    price: string;
    period?: string;
    features: string[];
    ctaLabel: string;
    ctaHref: string;
    highlight?: boolean;
  }[];
}
const { plans } = Astro.props;
---
<section class="s-plans">
  <div class="inoro-container">
    <div class="s-plans__grid">
      {plans.map((p) => (
        <div class={`s-plans__card ${p.highlight ? 'is-highlight' : ''}`}>
          {p.highlight && <div class="s-plans__badge">Recommended</div>}
          <h3>{p.name}</h3>
          <div class="s-plans__price">
            <span class="amount">{p.price}</span>
            {p.period && <span class="period">{p.period}</span>}
          </div>
          <ul>
            {p.features.map((f) => <li>{f}</li>)}
          </ul>
          <a class="s-plans__cta" href={p.ctaHref}>{p.ctaLabel}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .s-plans { padding: 4rem 0; background: #f8fafc; }
  .s-plans__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    max-width: 1150px;
    margin: 0 auto;
  }
  .s-plans__card {
    position: relative;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 2rem 1.75rem;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .s-plans__card.is-highlight {
    border-color: #1AA7E0;
    box-shadow: 0 25px 45px -25px rgba(26, 167, 224, 0.4);
    transform: translateY(-4px);
  }
  .s-plans__badge {
    position: absolute; top: -12px; left: 50%;
    transform: translateX(-50%);
    background: #1AA7E0; color: #fff;
    padding: 0.25rem 0.85rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .s-plans__card h3 {
    font-family: Play, Inter, sans-serif;
    color: #0f172a;
    margin: 0;
    font-size: 1.35rem;
  }
  .s-plans__price { display: flex; align-items: baseline; gap: 0.35rem; }
  .s-plans__price .amount {
    font-family: Play, Inter, sans-serif;
    color: #1AA7E0;
    font-size: 2.5rem;
    font-weight: 700;
  }
  .s-plans__price .period { color: #64748b; font-size: 0.9rem; }
  .s-plans__card ul {
    list-style: none; padding: 0; margin: 0.5rem 0;
    display: flex; flex-direction: column; gap: 0.6rem;
    flex: 1;
  }
  .s-plans__card li {
    color: #334155; font-size: 0.95rem;
    padding-left: 1.5rem; position: relative;
  }
  .s-plans__card li::before {
    content: "✓"; position: absolute; left: 0; top: 0;
    color: #1AA7E0; font-weight: 700;
  }
  .s-plans__cta {
    margin-top: auto;
    background: #1AA7E0;
    color: #fff;
    text-decoration: none;
    text-align: center;
    padding: 0.85rem 1.25rem;
    border-radius: 0.6rem;
    font-weight: 600;
    transition: background 0.15s ease;
  }
  .s-plans__cta:hover { background: #0E8AC1; }
</style>
