---
interface Props { body: string }
const { body } = Astro.props;
---
<section class="s-richbody">
  <div class="inoro-container">
    <article class="prose" set:html={body} />
  </div>
</section>

<style>
  .s-richbody { padding: 3rem 0; background: #fff; }
  .prose {
    max-width: 780px;
    margin: 0 auto;
    color: #334155;
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose :global(h2) {
    font-family: Sora, Inter, sans-serif;
    color: #0f172a;
    font-size: 1.75rem;
    margin: 2.5rem 0 1rem;
  }
  .prose :global(h3) {
    font-family: Sora, Inter, sans-serif;
    color: #0f172a;
    font-size: 1.35rem;
    margin: 2rem 0 0.75rem;
  }
  .prose :global(p) { margin: 0 0 1.25rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5rem; margin: 0 0 1.5rem; }
  .prose :global(li) { margin-bottom: 0.35rem; }
  .prose :global(a) { color: #1AA7E0; }
  .prose :global(strong) { color: #0f172a; }
</style>
