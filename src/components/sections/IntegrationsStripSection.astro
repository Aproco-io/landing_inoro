---
interface Props {
  heading?: string;
  names: string[];
  linkText?: string;
  linkHref?: string;
}
const { heading, names, linkText, linkHref } = Astro.props;
---
<section class="s-integrations">
  <div class="inoro-container">
    <div class="s-integrations__panel">
      <p class="s-integrations__caption">{heading ?? 'Works with your stack — no rip & replace'}</p>
      <div class="s-integrations__chips">
        {names.map((n) => <span class="chip">{n}</span>)}
      </div>
      {linkText && linkHref && (
        <a class="s-integrations__link" href={linkHref}>{linkText} →</a>
      )}
    </div>
  </div>
</section>

<style>
  .s-integrations { padding: 3rem 0; background: #f8fafc; }
  .s-integrations__panel {
    max-width: 1100px; margin: 0 auto;
    padding: 2rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 0.9rem;
    text-align: center;
  }
  .s-integrations__caption {
    color: #64748b;
    margin: 0 0 1.15rem;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .s-integrations__chips {
    display: flex; flex-wrap: wrap; gap: 0.55rem; justify-content: center;
    margin-bottom: 1.25rem;
  }
  .chip {
    background: #E8F5FC;
    color: #0E8AC1;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .s-integrations__link {
    color: #1AA7E0;
    font-weight: 500;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .s-integrations__link:hover { text-decoration: underline; }
</style>
