---
interface Props {
  kicker?: string;
  heading: string;
  pains: { icon?: string; title: string; body: string }[];
  costCard?: { heading: string; body: string };
}
const { kicker, heading, pains, costCard } = Astro.props;
---
<section class="s-problem">
  <div class="inoro-container">
    <div class="s-problem__head">
      {kicker && <span class="s-problem__kicker">{kicker}</span>}
      <h2>{heading}</h2>
    </div>
    <div class="s-problem__grid">
      {pains.map((p) => (
        <div class="s-problem__card">
          <div class="s-problem__icon">{p.icon ?? '⚠️'}</div>
          <h3>{p.title}</h3>
          <p set:html={p.body} />
        </div>
      ))}
      {costCard && (
        <div class="s-problem__cost">
          <div class="s-problem__cost-label">Cost of status quo</div>
          <h3>{costCard.heading}</h3>
          <p set:html={costCard.body} />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .s-problem { padding: 4rem 0; background: #fff; }
  .s-problem__head { text-align: center; max-width: 700px; margin: 0 auto 2.5rem; }
  .s-problem__kicker {
    display: inline-block; color: #1AA7E0;
    text-transform: uppercase; letter-spacing: 0.08em;
    font-size: 0.75rem; font-weight: 700; margin-bottom: 0.75rem;
  }
  .s-problem__head h2 {
    font-family: Sora, Inter, sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    margin: 0; color: #0f172a;
  }
  .s-problem__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.15rem;
  }
  .s-problem__card, .s-problem__cost {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 0.85rem;
    padding: 1.5rem;
  }
  .s-problem__cost {
    background: #0b1f3d;
    color: #fff;
    border-color: transparent;
  }
  .s-problem__icon {
    width: 40px; height: 40px;
    display: inline-flex; align-items: center; justify-content: center;
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border-radius: 0.5rem;
    margin-bottom: 0.85rem;
    font-size: 1.15rem;
  }
  .s-problem__cost-label {
    color: #1AA7E0;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .s-problem__card h3, .s-problem__cost h3 {
    font-family: Sora, Inter, sans-serif;
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }
  .s-problem__card h3 { color: #0f172a; }
  .s-problem__cost h3 { color: #fff; }
  .s-problem__card p { color: #475569; margin: 0; font-size: 0.95rem; line-height: 1.55; }
  .s-problem__cost p { color: #cbd5e1; margin: 0; font-size: 0.95rem; line-height: 1.55; }
</style>
