---
interface Props {
  heading?: string;
  cards: { title: string; body?: string; href: string }[];
}
const { heading, cards } = Astro.props;
---
<section class="s-related">
  <div class="inoro-container">
    <h2>{heading ?? 'Related resources'}</h2>
    <div class="s-related__grid">
      {cards.map((c) => (
        <a class="s-related__card" href={c.href}>
          <h3>{c.title}</h3>
          {c.body && <p set:html={c.body} />}
          <span class="s-related__arrow">Read more →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .s-related { padding: 4rem 0; background: #f8fafc; }
  .s-related h2 {
    font-family: Play, Inter, sans-serif;
    text-align: center;
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 2rem; color: #0f172a;
  }
  .s-related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.15rem;
    max-width: 1150px;
    margin: 0 auto;
  }
  .s-related__card {
    display: flex; flex-direction: column; gap: 0.55rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 0.85rem;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .s-related__card:hover {
    transform: translateY(-2px);
    border-color: rgba(26, 167, 224, 0.35);
    box-shadow: 0 12px 25px -18px rgba(15, 23, 42, 0.2);
  }
  .s-related__card h3 {
    font-family: Play, Inter, sans-serif;
    margin: 0; font-size: 1.05rem; color: #0f172a; line-height: 1.35;
  }
  .s-related__card p {
    margin: 0; color: #64748b; font-size: 0.9rem; line-height: 1.55;
  }
  .s-related__arrow { margin-top: auto; color: #1AA7E0; font-weight: 500; font-size: 0.9rem; }
</style>
