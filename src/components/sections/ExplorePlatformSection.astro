---
interface Props {
  heading?: string;
  links: { label: string; href: string; description?: string }[];
}
const { heading, links } = Astro.props;
---
<section class="s-explore">
  <div class="inoro-container">
    {heading && <h2>{heading}</h2>}
    <div class="s-explore__grid">
      {links.map((l) => (
        <a href={l.href} class="s-explore__link">
          <span class="s-explore__label">{l.label}</span>
          {l.description && <span class="s-explore__desc">{l.description}</span>}
          <span class="s-explore__arrow">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .s-explore { padding: 3rem 0; background: #fff; border-top: 1px solid #f1f5f9; }
  .s-explore h2 {
    font-family: Play, Inter, sans-serif;
    text-align: center;
    font-size: clamp(1.35rem, 2.8vw, 1.75rem);
    margin: 0 0 1.5rem; color: #0f172a;
  }
  .s-explore__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .s-explore__link {
    display: flex; flex-direction: column; gap: 0.15rem;
    padding: 1rem 1.15rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.6rem;
    text-decoration: none;
    color: #0f172a;
    background: #fff;
    transition: border-color 0.15s ease, background 0.15s ease;
    position: relative;
  }
  .s-explore__link:hover {
    border-color: rgba(26, 167, 224, 0.4);
    background: #E8F5FC;
  }
  .s-explore__label { font-weight: 600; font-size: 0.95rem; }
  .s-explore__desc { color: #64748b; font-size: 0.8rem; }
  .s-explore__arrow {
    position: absolute; top: 1rem; right: 1rem;
    color: #1AA7E0; opacity: 0.6;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .s-explore__link:hover .s-explore__arrow { opacity: 1; transform: translateX(2px); }
</style>
