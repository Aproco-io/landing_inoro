---
/** Static HTML body for GitHub Pages (base path /landing_inoro/).
 *  Used when React SPA would show 404 due to path mismatch.
 *  Since language now lives in the URL (/ = EN, /pl/ = PL), we render
 *  only one captured HTML variant per page. */
import { FORMSPREE_ID } from '../../formspree.config.js';
import capturedEn from '../data/captured-body.html?raw';
import capturedPl from '../data/captured-body.pl.html?raw';

interface Props { lang?: 'pl' | 'en' }
const { lang = 'en' } = Astro.props;

const formspreeReplace = (html) =>
  html.replace(/formspree\.io\/f\/[a-z0-9]+/gi, `formspree.io/f/${FORMSPREE_ID}`);

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') || '';
const isGithubSubpath = base.length > 0;

/**
 * Captured HTML uses relative paths like `assets/foo.png` and
 * `Polityka-Prywatnosci.pdf`. On GitHub Pages we rely on the `<base>` tag
 * in index.astro to resolve those. On Vercel / production root deploy
 * there's no `<base>`, so the browser resolves them against the current
 * page URL — which breaks for any non-root page like `/pl/`.
 * Prepend a leading `/` so they always resolve from site root.
 */
const rootRelativize = (html) =>
  isGithubSubpath
    ? html
    : html
        .replace(/(src|href)="assets\//g, '$1="/assets/')
        .replace(/(src|href)="Polityka-Prywatnosci\.pdf"/g, '$1="/Polityka-Prywatnosci.pdf"');

const useCaptured =
  !capturedEn.includes('Placeholder') &&
  capturedEn.includes('min-h-screen') &&
  capturedPl.includes('min-h-screen');
const source = lang === 'pl' ? capturedPl : capturedEn;
const html = useCaptured ? rootRelativize(formspreeReplace(source)) : '';
const asset = (p) => (base ? `${base}/${p}`.replace(/\/\//g, '/') : `/${p}`);
const segmentScriptSrc = asset('assets/segment-tabs-static.js');
const fallbackScriptSrc = asset('assets/segment-tabs-fallback.js');
const interactivityScriptSrc = asset('assets/static-page-interactivity.js') + '?v=8';
const cookieConsentScriptSrc = asset('assets/cookie-consent.js') + '?v=1';
---

{useCaptured ? (
  <>
    <div id={`lang-${lang}`} class="lang-root" set:html={html} />
    <script is:inline src={interactivityScriptSrc} />
    <script is:inline src={segmentScriptSrc} />
    <script is:inline src={cookieConsentScriptSrc} />
  </>
) : (
<>
