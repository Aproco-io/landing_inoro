---
/** Static HTML body for GitHub Pages (base path /landing_inoro/).
 *  Used when React SPA would show 404 due to path mismatch. */
---

<nav class="fixed top-0 left-0 right-0 z-50 py-4 px-6 flex items-center justify-between bg-slate-900/80 backdrop-blur border-b border-slate-700/50">
  <a href="#" class="text-xl font-bold text-white">InOro.ai</a>
  <div class="flex gap-6">
    <a href="#features" class="text-slate-300 hover:text-white">Features</a>
    <a href="#segments" class="text-slate-300 hover:text-white">Segments</a>
    <a href="#pricing" class="text-slate-300 hover:text-white">Pricing</a>
    <a href="#demo" class="text-slate-300 hover:text-white">Demo</a>
    <a href="#demo" class="bg-[#259bf7] text-white px-4 py-2 rounded-lg font-semibold hover:opacity-90">Get a quote</a>
  </div>
</nav>

<main>
  <section class="pt-24 pb-16 md:pt-32 md:pb-24 px-6 bg-slate-900 text-white">
    <div class="container mx-auto max-w-6xl flex flex-col md:flex-row items-center gap-12">
      <div class="flex-1">
        <p class="text-[#259bf7] uppercase tracking-wider text-sm font-semibold mb-4">AI Conversation Intelligence</p>
        <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight">
          Analyze 100% of calls.<br/>Boost sales &amp; compliance.
        </h1>
        <p class="text-xl text-slate-400 mb-8 max-w-xl">
          InOro.ai uses AI to transcribe and analyze every customer call. Improve agent performance, detect sales signals, and ensure compliance.
        </p>
        <a href="#demo" class="inline-block bg-[#259bf7] text-white px-8 py-4 rounded-lg font-bold text-lg hover:opacity-90">
          Request a demo →
        </a>
      </div>
      <div class="flex-1">
        <img src="assets/hero-dashboard-custom.png" alt="InOro Dashboard" class="w-full rounded-xl shadow-2xl" />
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 px-6 bg-slate-950 text-white">
    <div class="container mx-auto max-w-4xl text-center">
      <p class="text-[#259bf7] uppercase tracking-wider text-sm font-semibold mb-4">The Problem</p>
      <h2 class="text-3xl md:text-5xl font-bold mb-6">Most calls go unanalyzed</h2>
      <p class="text-xl text-slate-400">
        Traditional QA samples 1–5% of calls. You miss compliance risks, sales opportunities, and coaching moments. InOro analyzes every conversation.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24 px-6 bg-slate-900 text-white">
    <div class="container mx-auto max-w-6xl">
      <p class="text-[#259bf7] uppercase tracking-wider text-sm font-semibold mb-4">How it works</p>
      <h2 class="text-3xl md:text-5xl font-bold mb-12">Connect. Ingest. Analyze.</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-6 rounded-xl bg-slate-800/50 border border-slate-700">
          <h3 class="text-xl font-bold mb-2">1. Connect</h3>
          <p class="text-slate-400">Integrate with your telephony, CRMs, and WFM. No per-seat limits.</p>
        </div>
        <div class="p-6 rounded-xl bg-slate-800/50 border border-slate-700">
          <h3 class="text-xl font-bold mb-2">2. Ingest</h3>
          <p class="text-slate-400">100% of calls transcribed and stored in EU. Real-time and batch.</p>
        </div>
        <div class="p-6 rounded-xl bg-slate-800/50 border border-slate-700">
          <h3 class="text-xl font-bold mb-2">3. Analyze</h3>
          <p class="text-slate-400">AI scoring, emotion detection, compliance checks, sales signals.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="py-16 md:py-24 px-6 bg-slate-950 text-white">
    <div class="container mx-auto max-w-6xl text-center">
      <p class="text-[#259bf7] uppercase tracking-wider text-sm font-semibold mb-4">Features</p>
      <h2 class="text-3xl md:text-5xl font-bold mb-12">Everything you need</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-6 rounded-xl bg-slate-800/50">100% call transcription</div>
        <div class="p-6 rounded-xl bg-slate-800/50">Agent scoring &amp; QA</div>
        <div class="p-6 rounded-xl bg-slate-800/50">Emotion &amp; intent analysis</div>
        <div class="p-6 rounded-xl bg-slate-800/50">Compliance monitoring</div>
        <div class="p-6 rounded-xl bg-slate-800/50">Sales signal detection</div>
        <div class="p-6 rounded-xl bg-slate-800/50">EU data residency</div>
      </div>
    </div>
  </section>

  <section id="segments" class="py-16 md:py-24 px-6 bg-slate-900 text-white">
    <div class="container mx-auto max-w-6xl">
      <p class="text-[#259bf7] uppercase tracking-wider text-sm font-semibold mb-4">Segments</p>
      <h2 class="text-3xl md:text-5xl font-bold mb-8">Built for your industry</h2>
      <div class="flex flex-col md:flex-row gap-8">
        <div class="flex-1">
          <div class="flex gap-2 mb-6">
            <button type="button" class="px-4 py-2 rounded-lg bg-[#259bf7] text-white font-semibold">BPO</button>
            <button type="button" class="px-4 py-2 rounded-lg bg-slate-700 text-slate-300 font-semibold hover:bg-slate-600">BFSI</button>
            <button type="button" class="px-4 py-2 rounded-lg bg-slate-700 text-slate-300 font-semibold hover:bg-slate-600">Retail</button>
          </div>
          <p class="text-slate-400 mb-4">
            BPO: white-label reports, per-minute billing, agent benchmarking. Scale across hundreds of agents without per-seat costs.
          </p>
        </div>
        <div class="hidden md:block flex-1">
          <div class="segment-shot-wrap">
            <img class="segment-shot" src="assets/segment-bpo.png" alt="Segment BPO" data-segment="bpo" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="pricing" class="pricing-custom py-16 md:py-24">
    <div class="wrap">
      <div class="kicker">Pricing</div>
      <h2>Pay for what you use.<br/>Nothing more.</h2>
      <p class="subtitle">No per-seat fees. No hidden platform charges. Per-minute pricing that aligns with your actual call volume.</p>
      <div class="panel">
        <div class="grid">
          <div class="card">
            <div class="start">Starting from</div>
            <div class="price">€0.045</div>
            <div style="font-size:2rem; color:#cbd5e1;">per minute analyzed</div>
            <div class="muted" style="margin-top:0.7rem;">≈ 0.20 PLN / minute<br/>Transcription + full AI analysis included</div>
          </div>
          <div class="card">
            <ul>
              <li>100% call transcription</li>
              <li>Agent scoring &amp; QA</li>
              <li>Emotion &amp; intent analysis</li>
              <li>Compliance monitoring</li>
              <li>Sales signal detection</li>
              <li>AI chat interface</li>
              <li>Manager dashboards</li>
              <li>White-label reports (BPO)</li>
              <li>EU data residency</li>
            </ul>
          </div>
          <div class="card">
            <div class="muted">50 agents × 1,000 min/month</div>
            <div style="margin-top:0.35rem; font-size:2.2rem; color:#f8fafc; font-weight:700; font-family:Sora,Inter,sans-serif;">~€2,250/mo</div>
            <div class="muted">vs. €5,000-12,500 with per-seat tools</div>
            <a class="quote" href="#demo">Get a custom quote →</a>
            <div class="muted" style="margin-top:0.65rem;">30-day free pilot • No credit card</div>
          </div>
        </div>
        <div class="bottom">
          <strong style="color:#cbd5e1;">How InOro compares at typical BPO volumes</strong><br/>
          At 1,000 min/agent/month: InOro remains usage-based with no seat minimums.
        </div>
      </div>
    </div>
  </section>

  <section id="traction" class="py-16 md:py-24 px-6 bg-slate-900 text-white">
    <div class="container mx-auto max-w-6xl text-center">
      <h2 class="text-3xl md:text-5xl font-bold mb-4">Proven traction</h2>
      <p class="text-slate-400 mb-12">Trusted by contact centers across industries</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div><div class="text-3xl font-bold text-[#259bf7]">1B+</div><div class="font-semibold">Minutes analyzed</div><p class="text-slate-400 text-sm">Proven at scale</p></div>
        <div><div class="text-3xl font-bold text-[#259bf7]">50+</div><div class="font-semibold">Companies in pipeline</div><p class="text-slate-400 text-sm">Growing demand</p></div>
        <div><div class="text-3xl font-bold text-[#259bf7]">1,700+</div><div class="font-semibold">Agents at single client</div><p class="text-slate-400 text-sm">Scaling across teams</p></div>
        <div><div class="text-3xl font-bold text-[#259bf7]">6+</div><div class="font-semibold">Active customers</div><p class="text-slate-400 text-sm">BPO, BFSI, Retail</p></div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 px-6 bg-slate-950 text-white">
    <div class="container mx-auto max-w-3xl">
      <p class="text-[#259bf7] uppercase tracking-wider text-sm font-semibold mb-4">FAQ</p>
      <h2 class="text-3xl md:text-5xl font-bold mb-12">Common questions</h2>
      <div class="space-y-4">
        <details class="p-4 rounded-lg bg-slate-800/50"><summary class="font-semibold cursor-pointer">How does InOro integrate with my systems?</summary><p class="mt-2 text-slate-400">We integrate with major telephony, CRMs, and WFM. Setup typically takes days.</p></details>
        <details class="p-4 rounded-lg bg-slate-800/50"><summary class="font-semibold cursor-pointer">Where is my data stored?</summary><p class="mt-2 text-slate-400">All data is stored in the EU with full compliance (GDPR, etc.).</p></details>
        <details class="p-4 rounded-lg bg-slate-800/50"><summary class="font-semibold cursor-pointer">What's the pricing model?</summary><p class="mt-2 text-slate-400">Per-minute pricing. No per-seat fees. You pay for minutes analyzed.</p></details>
      </div>
    </div>
  </section>

  <section id="demo" class="py-16 md:py-24 px-6 bg-slate-900 text-white">
    <div class="container mx-auto max-w-xl text-center">
      <p class="text-[#259bf7] uppercase tracking-wider text-sm font-semibold mb-4">Demo</p>
      <h2 class="text-3xl md:text-5xl font-bold mb-6">Get a custom quote</h2>
      <p class="text-slate-400 mb-8">Request a 30-day free pilot. No credit card required.</p>
      <form class="space-y-4 text-left" action="https://formspree.io/f/xpwnqjvz" method="POST">
        <input type="text" name="name" placeholder="Name" required class="w-full px-4 py-3 rounded-lg bg-slate-800 border border-slate-600 text-white" />
        <input type="email" name="email" placeholder="Email" required class="w-full px-4 py-3 rounded-lg bg-slate-800 border border-slate-600 text-white" />
        <input type="text" name="company" placeholder="Company" class="w-full px-4 py-3 rounded-lg bg-slate-800 border border-slate-600 text-white" />
        <textarea name="message" placeholder="Message" rows="3" class="w-full px-4 py-3 rounded-lg bg-slate-800 border border-slate-600 text-white"></textarea>
        <button type="submit" class="w-full bg-[#259bf7] text-white py-4 rounded-lg font-bold hover:opacity-90">Submit</button>
      </form>
    </div>
  </section>
</main>

<footer class="py-12 px-6 bg-slate-950 text-slate-400 border-t border-slate-800">
  <div class="container mx-auto max-w-6xl flex flex-col md:flex-row justify-between items-center gap-6">
    <div class="font-bold text-white">InOro.ai</div>
    <div class="flex gap-6">
      <a href="#features" class="hover:text-white">Features</a>
      <a href="#pricing" class="hover:text-white">Pricing</a>
      <a href="#demo" class="hover:text-white">Contact</a>
    </div>
  </div>
</footer>

<script>
  (function segmentTabs() {
    const section = document.getElementById("segments");
    if (!section) return;
    const visual = section.querySelector(".hidden.md\\:block, [class*='hidden'][class*='md:block']");
    if (!visual) return;
    const img = visual.querySelector("img");
    if (!img) return;
    const map = {
      bpo: "assets/segment-bpo.png",
      bfsi: "assets/segment-bfsi.png",
      retail: "assets/hero-dashboard-custom.png",
    };
    const setImage = (key) => {
      img.src = map[key] || map.bpo;
      img.alt = "Segment " + key;
    };
    section.querySelectorAll("button").forEach((btn) => {
      btn.addEventListener("click", () => {
        section.querySelectorAll("button").forEach(b => { b.className = "px-4 py-2 rounded-lg bg-slate-700 text-slate-300 font-semibold hover:bg-slate-600"; });
        btn.className = "px-4 py-2 rounded-lg bg-[#259bf7] text-white font-semibold";
        const txt = (btn.textContent || "").toLowerCase();
        if (txt.includes("bpo")) setImage("bpo");
        else if (txt.includes("bfsi")) setImage("bfsi");
        else if (txt.includes("retail")) setImage("retail");
      });
    });
  })();
</script>
