---
/**
 * `<picture>` dla obrazów z `public/`, które mają obok siebie wariant `.webp`.
 *
 * Używane tam, gdzie ścieżka obrazu przychodzi z treści (front matter sekcji)
 * i wskazuje na `public/assets/...` — tych plików nie da się przepuścić przez
 * `astro:assets`. Jeśli obok `foo.png` leży `foo.webp`, przeglądarka dostanie
 * WebP, a PNG zostaje jako fallback. Bez `.webp` renderuje się zwykłe `<img>`.
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  src: string;
  alt: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { src, alt, loading = 'lazy', class: className } = Astro.props;

const webpSrc = src.replace(/\.(png|jpe?g)$/i, '.webp');
const hasWebp =
  webpSrc !== src &&
  !/^https?:/i.test(src) &&
  fs.existsSync(path.join('public', webpSrc.replace(/^\//, '')));
---
{hasWebp ? (
  <picture>
    <source srcset={webpSrc} type="image/webp" />
    <img src={src} alt={alt} loading={loading} decoding="async" class={className} />
  </picture>
) : (
  <img src={src} alt={alt} loading={loading} decoding="async" class={className} />
)}
