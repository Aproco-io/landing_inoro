---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { alternatesFor, SITE_URL } from '../data/i18n.ts';

interface Props {
  lang: 'pl' | 'en';
  title: string;
  description: string;
  currentPath?: string;
  ogImage?: string;
}

const { lang, title, description, currentPath, ogImage } = Astro.props;
const htmlLang = lang;

const alternates = currentPath
  ? alternatesFor(currentPath, lang)
  : { en: '/', pl: '/pl/' };
const canonicalUrl = `${SITE_URL}${currentPath ?? '/'}`;
const enUrl = `${SITE_URL}${alternates.en}`;
const plUrl = `${SITE_URL}${alternates.pl}`;
const ogImageUrl = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`)
  : `${SITE_URL}/assets/hero-dashboard-custom.png`;

// JSON-LD: Organization + SoftwareApplication. Emitted on every page.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'InOro.ai',
  url: SITE_URL,
  logo: `${SITE_URL}/assets/logos/InOro_Logo.svg`,
  email: 'contact@inoro.ai',
  parentOrganization: {
    '@type': 'Organization',
    name: 'Aproco',
    url: 'https://aproco.io',
  },
  areaServed: ['PL', 'EU'],
  description: lang === 'pl'
    ? 'InOro to platforma analizy rozmów AI dla contact centers — transkrypcja, ocena QA, analiza mowy dla 100% rozmów.'
    : "InOro is an AI conversation intelligence platform for contact centers — transcription, QA scoring, speech analytics for 100% of calls.",
};
const softwareApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'InOro',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, on-premise',
  offers: {
    '@type': 'Offer',
    price: lang === 'pl' ? '0.20' : '0.05',
    priceCurrency: lang === 'pl' ? 'PLN' : 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: lang === 'pl' ? '0.20' : '0.05',
      priceCurrency: lang === 'pl' ? 'PLN' : 'EUR',
      unitText: lang === 'pl' ? 'analizowana minuta' : 'analyzed minute',
    },
  },
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="860" />
    <meta property="og:image:height" content="900" />
    <meta property="og:site_name" content="InOro.ai" />
    <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="pl" href={plUrl} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/`} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationSchema)} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-M6396RL0EK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-M6396RL0EK');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Play:wght@400;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --primary: #1AA7E0;
        --primary-dark: #0E8AC1;
        --pastel: #E8F5FC;
        --accent: #10b981;
        --success: #22C55E;
        --warning: #F59E0B;
        --danger: #EF4444;
        --bg: #f8fafc;
        --fg: #0f172a;
        --muted-fg: #64748b;
        --border: #e2e8f0;
        --card: #ffffff;
      }
      *,
      *::before,
      *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: Inter, system-ui, sans-serif;
        line-height: 1.6;
      }
      h1, h2, h3, h4 { font-family: Play, Inter, sans-serif; letter-spacing: -0.01em; }
      a { color: var(--primary); }
      img { max-width: 100%; height: auto; }
      .inoro-container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }
    </style>
  </head>
  <body>
    <Nav lang={lang} currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
