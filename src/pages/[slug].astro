---
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import BulletList from '../components/BulletList.astro';
import CtaSection from '../components/CtaSection.astro';
import MarkdownBody from '../components/MarkdownBody.astro';
import SectionRenderer from '../components/sections/SectionRenderer.astro';

export async function getStaticPaths() {
  const products = await getCollection('product');
  return products.map((entry) => ({
    params: { slug: entry.data.slug.replace(/^\//, '').replace(/\/$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const lang = data.lang;

const homeCrumb = lang === 'pl'
  ? { label: 'Strona główna', href: '/' }
  : { label: 'Home', href: '/' };
const parentCrumb = lang === 'pl' ? { label: 'Produkt' } : { label: 'Product' };
const breadcrumbs = [homeCrumb, parentCrumb, { label: data.title }];

const useSections = Array.isArray(data.sections) && data.sections.length > 0;
---
<PageLayout
  lang={lang}
  title={data.seo?.metaTitle ?? data.title}
  description={data.seo?.metaDescription ?? data.description}
  currentPath={data.slug}
>
  {useSections ? (
    <SectionRenderer sections={data.sections!} lang={lang} breadcrumbs={breadcrumbs} />
  ) : (
    <>
      {data.hero && (
        <PageHero
          kicker={data.hero.kicker}
          heading={data.hero.heading}
          subheading={data.hero.subheading}
          primaryCta={data.hero.primaryCta}
          secondaryCta={data.hero.secondaryCta}
          breadcrumbs={breadcrumbs}
        />
      )}

      {data.features.length > 0 && (
        <FeatureGrid
          kicker={lang === 'pl' ? 'Możliwości' : 'Capabilities'}
          heading={lang === 'pl' ? 'Co zyskujesz' : 'What you get'}
          features={data.features}
        />
      )}

      {data.bullets.length > 0 && (
        <BulletList
          kicker={lang === 'pl' ? 'Kluczowe fakty' : 'Key facts'}
          heading={lang === 'pl' ? 'W skrócie' : 'At a glance'}
          items={data.bullets}
        />
      )}

      <MarkdownBody>
        <Content />
      </MarkdownBody>

      {data.cta && (
        <CtaSection
          heading={data.cta.heading}
          subheading={data.cta.subheading}
          buttonLabel={data.cta.buttonLabel}
          buttonHref={data.cta.buttonHref}
        />
      )}
    </>
  )}
</PageLayout>
