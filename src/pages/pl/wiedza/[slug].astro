---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import FeatureGrid from '../../../components/FeatureGrid.astro';
import BulletList from '../../../components/BulletList.astro';
import CtaSection from '../../../components/CtaSection.astro';
import MarkdownBody from '../../../components/MarkdownBody.astro';
import SectionRenderer from '../../../components/sections/SectionRenderer.astro';

export async function getStaticPaths() {
  const items = await getCollection('resources', (e) => e.data.lang === 'pl');
  return items.map((entry) => ({
    params: { slug: entry.data.slug.replace(/^\/pl\/wiedza\//, '').replace(/\/$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const breadcrumbs = [{ label: 'Strona główna', href: '/pl/' }, { label: 'Wiedza' }, { label: data.title }];
const useSections = Array.isArray(data.sections) && data.sections.length > 0;
---
<PageLayout
  lang="pl"
  title={data.seo?.metaTitle ?? data.title}
  description={data.seo?.metaDescription ?? data.description}
  currentPath={data.slug}
>
  {useSections ? (
    <SectionRenderer sections={data.sections!} lang="pl" breadcrumbs={breadcrumbs} />
  ) : (
    <>
      {data.hero && (
        <PageHero
          kicker={data.hero.kicker}
          heading={data.hero.heading}
          subheading={data.hero.subheading}
          primaryCta={data.hero.primaryCta}
          breadcrumbs={breadcrumbs}
        />
      )}
      {data.bullets.length > 0 && (
        <BulletList kicker="Najważniejsze" heading="W skrócie" items={data.bullets} />
      )}
      <MarkdownBody><Content /></MarkdownBody>
      {data.features.length > 0 && (
        <FeatureGrid kicker="Zobacz też" heading="Powiązane treści" features={data.features} />
      )}
      {data.cta && (
        <CtaSection
          heading={data.cta.heading}
          subheading={data.cta.subheading}
          buttonLabel={data.cta.buttonLabel}
          buttonHref={data.cta.buttonHref}
        />
      )}
    </>
  )}
</PageLayout>
