---
import PageLayout from '../../layouts/PageLayout.astro';
import HeroSection from '../../components/sections/HeroSection.astro';
import AtGlanceSection from '../../components/sections/AtGlanceSection.astro';
import { FORMSPREE_ID } from '../../../formspree.config.js';
---
<PageLayout
  lang="pl"
  title="Umów demo — zobacz InOro na swoich rozmowach | InOro"
  description="30-minutowe demo InOro na Twoich nagraniach oraz 30-dniowy bezpłatny pilotaż."
  currentPath="/pl/demo/"
>
  <HeroSection
    badge="Umów demo"
    heading="Zobacz InOro na własnych rozmowach"
    subheading="30-minutowe demo dopasowane do Twojej operacji, na Twoich nagraniach. Jeśli to, co zobaczysz, będzie miało sens — startujemy 30-dniowy bezpłatny pilotaż."
    breadcrumbs={[{ label: 'Strona główna', href: '/pl/' }, { label: 'Demo' }]}
  />

  <section class="demo-form">
    <div class="inoro-container">
      <div class="demo-form__panel">
        <form action={`https://formspree.io/f/${FORMSPREE_ID}`} method="POST">
          <div class="row">
            <label>
              Imię i nazwisko
              <input type="text" name="name" required />
            </label>
            <label>
              Służbowy e-mail
              <input type="email" name="email" required />
            </label>
          </div>
          <div class="row">
            <label>
              Firma
              <input type="text" name="company" required />
            </label>
            <label>
              Liczba konsultantów
              <input type="text" name="agents" placeholder="np. 50, 500, 5000" />
            </label>
          </div>
          <label>
            Wiadomość (opcjonalnie)
            <textarea name="message" rows="4" placeholder="Który obszar interesuje Cię najbardziej? Masz konkretne pytania?"></textarea>
          </label>
          <label>
            Twoja telefonia / system nagrywania
            <input type="text" name="telephony" placeholder="Genesys, Avaya, Cisco, inny…" />
          </label>
          <button type="submit">Umów demo</button>
          <p class="demo-form__note">30-dniowy bezpłatny pilotaż • standardowa integracja zajmuje 1 dzień</p>
          <p class="demo-form__privacy">
            Administratorem danych osobowych jest Aproco (operator InOro.ai). Dane z formularza
            wykorzystamy wyłącznie do kontaktu w sprawie demo.
            <a href="/Polityka-Prywatnosci.pdf" target="_blank" rel="noopener noreferrer">Polityka prywatności</a>
          </p>
        </form>
      </div>
    </div>
  </section>

  <AtGlanceSection
    kicker="Czego się spodziewać"
    heading="Jak wygląda te 30 minut"
    bullets={[
      "5 min — Twoja operacja i wyzwania po stronie jakości",
      "20 min — demo InOro na scenariuszach z Twojego obszaru",
      "5 min — szacunek kosztu dla Twojego wolumenu i kolejne kroki",
      "Po spotkaniu: plan uruchomienia 30-dniowego pilotażu, jeśli zdecydujesz się kontynuować",
    ]}
  />
</PageLayout>

<style>
  .demo-form { padding: 3rem 0; background: #f8fafc; }
  .demo-form__panel {
    max-width: 720px; margin: 0 auto;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 2.25rem 2.5rem;
  }
  .demo-form form { display: flex; flex-direction: column; gap: 1rem; }
  .demo-form .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 600px) { .demo-form .row { grid-template-columns: 1fr; } }
  .demo-form label {
    display: flex; flex-direction: column;
    gap: 0.4rem;
    color: #0f172a;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .demo-form input,
  .demo-form textarea {
    padding: 0.75rem 0.85rem;
    border-radius: 0.5rem;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #0f172a;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 400;
  }
  .demo-form input:focus,
  .demo-form textarea:focus {
    outline: 2px solid #1AA7E0;
    outline-offset: -1px;
    border-color: transparent;
  }
  .demo-form button {
    background: #1AA7E0;
    color: #fff;
    padding: 0.9rem 1.5rem;
    border-radius: 0.55rem;
    border: none;
    font-weight: 700;
    font-family: inherit;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.15s ease;
    margin-top: 0.5rem;
  }
  .demo-form button:hover { background: #0E8AC1; }
  .demo-form__privacy {
    margin: 0.75rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: #64748b;
    text-align: center;
  }
  .demo-form__privacy a { color: #1AA7E0; }
  .demo-form__note {
    text-align: center;
    color: #64748b;
    font-size: 0.85rem;
    margin: 0.75rem 0 0;
  }
</style>
