---
import PageLayout from '../layouts/PageLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import AtGlanceSection from '../components/sections/AtGlanceSection.astro';
import { FORMSPREE_ID } from '../../formspree.config.js';
---
<PageLayout
  lang="en"
  title="Book a Demo — See InOro on Your Calls | InOro"
  description="30-minute demo of InOro on your own recordings. 30-day free pilot, no credit card."
  currentPath="/demo/"
>
  <HeroSection
    badge="Book a demo"
    heading="See InOro on your own calls"
    subheading="30-minute demo tailored to your operation, using your recordings. If you like what you see, start a 30-day free pilot — no credit card, no commitment."
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Demo' }]}
  />

  <section class="demo-form">
    <div class="inoro-container">
      <div class="demo-form__panel">
        <form action={`https://formspree.io/f/${FORMSPREE_ID}`} method="POST">
          <div class="row">
            <label>
              Name
              <input type="text" name="name" required />
            </label>
            <label>
              Work email
              <input type="email" name="email" required />
            </label>
          </div>
          <div class="row">
            <label>
              Company
              <input type="text" name="company" required />
            </label>
            <label>
              Number of agents
              <input type="text" name="agents" placeholder="e.g. 50, 500, 5000" />
            </label>
          </div>
          <label>
            Message (optional)
            <textarea name="message" rows="4" placeholder="Which use case interests you most? Any specific questions?"></textarea>
          </label>
          <label>
            Your telephony / recording system
            <input type="text" name="telephony" placeholder="Genesys, Avaya, Cisco, other…" />
          </label>
          <button type="submit">Book a demo</button>
          <p class="demo-form__note">30-day free pilot • no credit card • setup in 1–2 weeks</p>
        </form>
      </div>
    </div>
  </section>

  <AtGlanceSection
    kicker="What to expect"
    heading="How the 30 minutes go"
    bullets={[
      "5 min — your operation, your quality challenges",
      "20 min — InOro demo on scenarios matching your use case",
      "5 min — pricing estimate for your volume, next steps",
      "Follow-up: setup plan for the 30-day pilot if you choose to continue",
    ]}
  />
</PageLayout>

<style>
  .demo-form { padding: 3rem 0; background: #f8fafc; }
  .demo-form__panel {
    max-width: 720px; margin: 0 auto;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 2.25rem 2.5rem;
  }
  .demo-form form { display: flex; flex-direction: column; gap: 1rem; }
  .demo-form .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 600px) { .demo-form .row { grid-template-columns: 1fr; } }
  .demo-form label {
    display: flex; flex-direction: column;
    gap: 0.4rem;
    color: #0f172a;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .demo-form input,
  .demo-form textarea {
    padding: 0.75rem 0.85rem;
    border-radius: 0.5rem;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #0f172a;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 400;
  }
  .demo-form input:focus,
  .demo-form textarea:focus {
    outline: 2px solid #1AA7E0;
    outline-offset: -1px;
    border-color: transparent;
  }
  .demo-form button {
    background: #1AA7E0;
    color: #fff;
    padding: 0.9rem 1.5rem;
    border-radius: 0.55rem;
    border: none;
    font-weight: 700;
    font-family: inherit;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.15s ease;
    margin-top: 0.5rem;
  }
  .demo-form button:hover { background: #0E8AC1; }
  .demo-form__note {
    text-align: center;
    color: #64748b;
    font-size: 0.85rem;
    margin: 0.75rem 0 0;
  }
</style>
