<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />
    <title>InOro.ai | AI-Powered Conversation Intelligence for Contact Centers</title>
    <meta
      name="description"
      content="InOro.ai analyzes 100% of customer calls with AI to boost sales, service quality, and compliance. Used by BPO, BFSI, and Retail leaders."
    />
    <meta property="og:title" content="InOro.ai | AI-Powered Conversation Intelligence" />
    <meta
      property="og:description"
      content="Analyze 100% of customer calls with AI. Boost sales, service quality, and compliance."
    />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="assets/index-DCgweMnR.css" />
    <style is:global>
      /* Custom pricing block replacing slider section */
      .pricing-custom {
        background: #020b1f;
        color: #e2e8f0;
      }
      .pricing-custom .wrap {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 1rem;
      }
      .pricing-custom .kicker {
        color: #259bf7;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.75rem;
        font-weight: 700;
      }
      .pricing-custom h2 {
        margin: 0.5rem 0 0;
        font-family: Sora, Inter, sans-serif;
        line-height: 1.05;
        font-size: clamp(2.25rem, 5vw, 4rem);
        color: #f8fafc;
      }
      .pricing-custom .subtitle {
        margin-top: 1rem;
        max-width: 40rem;
        color: #94a3b8;
        font-size: 1.15rem;
      }
      .pricing-custom .panel {
        margin-top: 2.25rem;
        border-radius: 1.05rem;
        border: 1px solid #1e3a66;
        background: #0b1f3d;
        padding: 1.35rem;
      }
      .pricing-custom .grid {
        display: grid;
        grid-template-columns: 1fr 1.1fr 1fr;
        gap: 1rem;
      }
      .pricing-custom .card {
        background: #0a162d;
        border: 1px solid #1b3258;
        border-radius: 0.9rem;
        padding: 1.1rem;
      }
      .pricing-custom .start {
        color: #64748b;
        font-size: 0.95rem;
      }
      .pricing-custom .price {
        margin: 0.2rem 0 0.25rem;
        font-family: Sora, Inter, sans-serif;
        font-size: clamp(2.3rem, 5vw, 3.6rem);
        color: #259bf7;
        font-weight: 700;
      }
      .pricing-custom .muted {
        color: #64748b;
      }
      .pricing-custom ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .pricing-custom li {
        margin: 0.6rem 0;
        color: #cbd5e1;
      }
      .pricing-custom li::before {
        content: "✓";
        margin-right: 0.55rem;
        color: #259bf7;
        font-weight: 700;
      }
      .pricing-custom .quote {
        margin-top: 0.9rem;
        display: inline-block;
        width: 100%;
        background: #259bf7;
        color: #ffffff;
        text-align: center;
        padding: 0.82rem 1rem;
        border-radius: 0.7rem;
        text-decoration: none;
        font-weight: 700;
      }
      .pricing-custom .bottom {
        margin-top: 1rem;
        border-radius: 0.9rem;
        border: 1px solid #1b3258;
        background: #0a162d;
        color: #94a3b8;
        padding: 0.9rem 1rem;
      }
      @media (max-width: 980px) {
        .pricing-custom .grid {
          grid-template-columns: 1fr;
        }
      }

      .segment-shot-wrap {
        border-radius: 0.75rem;
        overflow: hidden;
        border: 1px solid #dbe4f0;
        background: #eef2f7;
      }

      .segment-shot {
        display: block;
        width: 100%;
        height: auto;
        object-fit: cover;
      }

    </style>
  </head>
  <body>
    <div id="root"></div>
    <script type="module" src="assets/index-CvwG9B6w.js"></script>
    <script>
      (function mountCustomPricing() {
        const pricing = document.getElementById("pricing");
        if (!pricing) {
          window.requestAnimationFrame(mountCustomPricing);
          return;
        }
        if (pricing.dataset.pricingMounted === "1") return;
        pricing.dataset.pricingMounted = "1";
        pricing.className = "pricing-custom py-16 md:py-24";
        pricing.innerHTML = `
          <div class="wrap">
            <div class="kicker">Pricing</div>
            <h2>Pay for what you use.<br/>Nothing more.</h2>
            <p class="subtitle">No per-seat fees. No hidden platform charges. Per-minute pricing that aligns with your actual call volume.</p>

            <div class="panel">
              <div class="grid">
                <div class="card">
                  <div class="start">Starting from</div>
                  <div class="price">€0.045</div>
                  <div style="font-size:2rem; color:#cbd5e1;">per minute analyzed</div>
                  <div class="muted" style="margin-top:0.7rem;">≈ 0.20 PLN / minute<br/>Transcription + full AI analysis included</div>
                </div>

                <div class="card">
                  <ul>
                    <li>100% call transcription</li>
                    <li>Agent scoring & QA</li>
                    <li>Emotion & intent analysis</li>
                    <li>Compliance monitoring</li>
                    <li>Sales signal detection</li>
                    <li>AI chat interface</li>
                    <li>Manager dashboards</li>
                    <li>White-label reports (BPO)</li>
                    <li>EU data residency</li>
                  </ul>
                </div>

                <div class="card">
                  <div class="muted">50 agents × 1,000 min/month</div>
                  <div style="margin-top:0.35rem; font-size:2.2rem; color:#f8fafc; font-weight:700; font-family:Sora,Inter,sans-serif;">~€2,250/mo</div>
                  <div class="muted">vs. €5,000-12,500 with per-seat tools</div>
                  <a class="quote" href="#demo">Get a custom quote →</a>
                  <div class="muted" style="margin-top:0.65rem;">30-day free pilot • No credit card</div>
                </div>
              </div>

              <div class="bottom">
                <strong style="color:#cbd5e1;">How InOro compares at typical BPO volumes</strong><br/>
                At 1,000 min/agent/month: InOro remains usage-based with no seat minimums.
              </div>
            </div>
          </div>
        `;
      })();

      (function removeLargeImages() {
        const tryRemove = () => {
          const targets = ["How InOro Works"];
          let changed = false;

          targets.forEach((alt) => {
            const img = document.querySelector(`img[alt="${alt}"]`);
            if (!img) return;
            const wrapper = img.closest("div");
            if (wrapper) {
              wrapper.remove();
              changed = true;
            }
          });

          if (!changed) setTimeout(tryRemove, 300);
        };

        tryRemove();
      })();

      (function replaceHeroDashboardImage() {
        const tryReplace = () => {
          const heroImg = document.querySelector('img[alt="InOro Dashboard"]');
          if (!heroImg) {
            setTimeout(tryReplace, 300);
            return;
          }
          heroImg.src = "assets/hero-dashboard-custom.png";
          heroImg.srcset = "";
        };

        tryReplace();
      })();

      (function mountSegmentScreenshots() {
        const tryMount = () => {
          const section = document.getElementById("segments");
          if (!section) {
            setTimeout(tryMount, 300);
            return;
          }

          const visual = section.querySelector(".hidden.md\\:block");
          if (!visual) {
            setTimeout(tryMount, 300);
            return;
          }

          const map = {
            bpo: "assets/segment-bpo.png",
            bfsi: "assets/segment-bfsi.png",
            retail: "assets/hero-dashboard-custom.png",
          };

          const setImage = (key) => {
            const src = map[key] || map.bpo;
            visual.innerHTML = `
              <div class="segment-shot-wrap">
                <img class="segment-shot" src="${src}" alt="Segment ${key}" />
              </div>
            `;
          };

          setImage("bpo");

          const tabs = section.querySelectorAll("button");
          tabs.forEach((btn) => {
            btn.addEventListener("click", () => {
              const txt = (btn.textContent || "").toLowerCase();
              if (txt.includes("bpo")) setImage("bpo");
              else if (txt.includes("bfsi")) setImage("bfsi");
              else if (txt.includes("retail")) setImage("retail");
            });
          });
        };

        tryMount();
      })();

    </script>
  </body>
</html>
