<script>
  // ---- NAV SCROLL ----
  const nav = document.getElementById('main-nav');
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  // ---- HAMBURGER ----
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');

  hamburger.addEventListener('click', () => {
    const isOpen = mobileMenu.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', String(isOpen));
  });

  document.querySelectorAll('.mob-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.remove('open');
      hamburger.setAttribute('aria-expanded', 'false');
    });
  });

  // ---- FAQ ----
  document.querySelectorAll('.faq-question').forEach(q => {
    q.addEventListener('click', () => {
      const item = q.parentElement;
      const isOpen = item.classList.toggle('open');
      q.setAttribute('aria-expanded', String(isOpen));
    });
    q.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        q.click();
      }
    });
  });

  // ---- TABS ----
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));

      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      const tab = btn.dataset.tab;
      document.getElementById(`tab-${tab}`).classList.add('active');
    });
  });

  // ---- CALCULATOR ----
  const agentsSlider = document.getElementById('agents-slider');
  const minsSlider = document.getElementById('mins-slider');
  const agentsDisplay = document.getElementById('agents-display');
  const minsDisplay = document.getElementById('mins-display');
  const calcResult = document.getElementById('calc-result');
  const calcMinutes = document.getElementById('calc-minutes');

  function updateCalc() {
    const agents = parseInt(agentsSlider.value);
    const mins = parseInt(minsSlider.value);
    const monthlyMins = agents * mins * 20;
    const cost = (monthlyMins * 0.045).toFixed(0);
    agentsDisplay.textContent = agents + ' agents';
    minsDisplay.textContent = mins + ' min/day';
    calcMinutes.textContent = '~' + monthlyMins.toLocaleString() + ' min/month';
    calcResult.textContent = '€' + parseInt(cost).toLocaleString();
  }

  agentsSlider.addEventListener('input', updateCalc);
  minsSlider.addEventListener('input', updateCalc);
  updateCalc();

  // ---- FORM ----
  document.getElementById('form-submit').addEventListener('click', () => {
    const name = document.getElementById('f-name').value.trim();
    const email = document.getElementById('f-email').value.trim();
    const company = document.getElementById('f-company').value.trim();

    if (!name || !email || !company) {
      alert('Please fill in your name, work email, and company name.');
      return;
    }

    const emailRx = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRx.test(email)) {
      alert('Please enter a valid email address.');
      return;
    }

    // TODO: Connect to backend (Aproco contact form or CRM)
    // Endpoint: https://aproco.io/contact-2 or custom backend
    document.getElementById('form-fields').style.display = 'none';
    document.getElementById('form-success').style.display = 'block';
  });

  // ---- SCROLL ANIMATIONS ----
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.problem-card, .step, .feature-card, .traction-stat').forEach(el => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(20px)';
      el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
      observer.observe(el);
    });
  }
</script>

