---
import StaticBody from '../components/StaticBody.astro';
import Nav from '../components/Nav.astro';
import HomeStyles from '../components/HomeStyles.astro';
const base = import.meta.env.BASE_URL || '/';
const isGithub = base !== '/' && base.length > 1;
const rawBase = import.meta.env.PUBLIC_FULL_BASE_URL
  || (isGithub && (import.meta.env.SITE || '').replace(/\/$/, '') + base)
  || '';
const assetBase = rawBase && !rawBase.endsWith('/') ? rawBase + '/' : rawBase;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {isGithub && <base href={assetBase} />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Automatyczny wybór języka. Działa TYLKO na stronie głównej EN (/)
         i tylko w jedną stronę: / → /pl/. Wersje pod konkretnymi adresami
         (/pl/analiza-rozmow/, /conversation-intelligence/) nigdy nie
         przekierowują — użytkownik trafił tam świadomie.
         Skrypt musi być inline i przed CSS, żeby przekierować przed
         pierwszym renderem (bez mignięcia angielskiej treści). -->
    <script is:inline>
      (function () {
        var PREF_KEY = 'inoro-lang-pref';
        var PL_HOME = '/pl/';

        function goPl() {
          if (location.pathname === PL_HOME) return;
          location.replace(PL_HOME + location.search + location.hash);
        }

        // 1. Boty zostają na /. Googlebot musi zaindeksować wersję EN pod
        //    adresem głównym, inaczej hreflang traci sens.
        var ua = navigator.userAgent || '';
        if (/bot|crawl|spider|slurp|bingpreview|facebookexternalhit|embedly|quora link preview|outbrain|pinterest|vkShare|W3C_Validator|lighthouse|gtmetrix|pingdom|headlesschrome/i.test(ua)) return;

        // 2. Jawny parametr ?lang= wygrywa ze wszystkim i zostaje zapamiętany.
        //    Daje działający link "pokaż mi wersję EN" do wklejenia komukolwiek.
        var forced = null;
        try { forced = new URLSearchParams(location.search).get('lang'); } catch (e) {}
        if (forced === 'en' || forced === 'pl') {
          try { localStorage.setItem(PREF_KEY, forced); } catch (e) {}
          if (forced === 'pl') goPl();
          return;
        }

        // 3. Wcześniejszy świadomy wybór (kliknięcie w przełącznik) ma
        //    pierwszeństwo przed ustawieniami przeglądarki.
        var stored = null;
        try { stored = localStorage.getItem(PREF_KEY); } catch (e) {}
        if (stored === 'en') return;
        if (stored === 'pl') { goPl(); return; }

        // 4. Wejście z tej samej domeny = nawigacja wewnętrzna (np. ktoś
        //    właśnie kliknął EN na /pl/). Nie odsyłamy go z powrotem.
        if (document.referrer && document.referrer.indexOf(location.origin) === 0) return;

        // 5. Dopiero teraz preferencje przeglądarki, w kolejności priorytetu.
        //    Pierwsze trafienie wygrywa: ['en-GB','pl'] zostaje na EN,
        //    ['pl','en'] idzie na PL.
        var langs = (navigator.languages && navigator.languages.length)
          ? navigator.languages
          : [navigator.language || navigator.userLanguage || ''];
        for (var i = 0; i < langs.length; i++) {
          var l = String(langs[i]).toLowerCase();
          if (l.indexOf('pl') === 0) { goPl(); return; }
          if (l.indexOf('en') === 0) return;
        }
        // Żaden z obsługiwanych języków — zostaje EN jako domyślny.
      })();
    </script>
    <title>InOro.ai | AI-Powered Conversation Intelligence for Contact Centers</title>
    <meta
      name="description"
      content="InOro.ai analyzes 100% of customer calls with AI to boost sales, service quality, and compliance. Used by BPO, BFSI, and Retail leaders."
    />
    <meta property="og:title" content="InOro.ai | AI-Powered Conversation Intelligence" />
    <meta
      property="og:description"
      content="Analyze 100% of customer calls with AI. Boost sales, service quality, and compliance."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://inoro.ai/" />
    <meta property="og:image" content="https://inoro.ai/assets/hero-dashboard-custom.png" />
    <meta property="og:site_name" content="InOro.ai" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://inoro.ai/assets/hero-dashboard-custom.png" />
    <link rel="canonical" href="https://inoro.ai/" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'InOro.ai',
      url: 'https://inoro.ai',
      logo: 'https://inoro.ai/assets/logos/InOro_Logo.svg',
      email: 'contact@inoro.ai',
      parentOrganization: { '@type': 'Organization', name: 'Aproco', url: 'https://aproco.io' },
      areaServed: ['PL', 'EU'],
      description: 'InOro is an AI conversation intelligence platform for contact centers — transcription, QA scoring, speech analytics for 100% of calls.',
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'InOro',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web, on-premise',
      offers: {
        '@type': 'Offer', price: '0.05', priceCurrency: 'EUR',
        priceSpecification: { '@type': 'UnitPriceSpecification', price: '0.05', priceCurrency: 'EUR', unitText: 'analyzed minute' },
      },
    })} />
    <link rel="alternate" hreflang="en" href="https://inoro.ai/" />
    <link rel="alternate" hreflang="pl" href="https://inoro.ai/pl/" />
    <link rel="alternate" hreflang="x-default" href="https://inoro.ai/" />
    <!-- Google Analytics -->
    <!-- Consent Mode v2 — must run BEFORE gtag/js so nothing is stored pre-consent -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-M6396RL0EK"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-M6396RL0EK');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap&subset=latin-ext"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="assets/index-DCgweMnR.css" />
    <HomeStyles />
  </head>
  <body>
    <Nav lang="en" currentPath="/" />
    <StaticBody lang="en" />
  </body>
</html>
